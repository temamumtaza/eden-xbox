  Package manifest for Eden's Xbox UWP frontend and Direct3D 12 renderer (src/eden_uwp).
  Sideloaded through the Xbox Device Portal in Dev Mode; see docs/xbox/xbox_deploy.md.

  Identity/Publisher must match the signing certificate's subject exactly, or the
  Device Portal rejects the package. tools/xbox/package-appx.ps1 keeps them in sync.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    IgnorableNamespaces="uap">

  <Identity Name="EdenEmuProject.EdenXbox"
            Publisher="CN=EdenXboxDev"
            Version="0.2.75.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Eden Xbox</DisplayName>
    <PublisherDisplayName>Eden Emulator Project</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows.Universal covers the Xbox Series X|S Dev Mode host. MinVersion is the oldest
         Xbox OS base we target; MaxVersionTested only gates OS-version-dependent behaviour. -->
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
    <!-- The exe hard-imports the Store CRT (VCRUNTIME140_APP, MSVCP140_APP,
         MSVCP140_ATOMIC_WAIT_APP, MSVCP140_CODECVT_IDS_APP, VCRUNTIME140_1_APP), which lives in
         this framework package, not in ours. Undeclared, the app fails to ACTIVATE on-console with
         a generic launch error and no crash dump. The console needs the matching
         Microsoft.VCLibs.x64.14.00.appx installed too - upload it as a dependency package in the
         Device Portal alongside ours. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00"
                       MinVersion="14.0.33519.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- EntryPoint for a plain C++/WinRT CoreApplication app (wWinMain + IFrameworkView, see
         uwp_boot.cpp) is the conventional "<exe>.App" moniker; there is no activatable class. -->
    <Application Id="App" Executable="eden-uwp.exe" EntryPoint="eden-uwp.App">
      <uap:VisualElements
          DisplayName="Eden Xbox"
          Description="Eden Nintendo Switch emulator for Xbox Developer Mode."
          BackgroundColor="#1C1C1C"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1C1C1C" />
      </uap:VisualElements>
      <!-- These types are read directly from UNC folders and removable volumes. The
           declarations are required by the UWP file-access model; they do not make
           arbitrary Xbox app-private folders accessible. -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="edenstorage">
            <uap:SupportedFileTypes>
              <!-- Windows validates file-type associations case-insensitively, matching the
                   scanner. Declare one canonical lowercase extension for each format. -->
              <uap:FileType>.nsp</uap:FileType>
              <uap:FileType>.xci</uap:FileType>
              <uap:FileType>.nro</uap:FileType>
              <uap:FileType>.keys</uap:FileType>
              <uap:FileType>.nca</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- THE critical one: codeGeneration unlocks VirtualProtectFromApp / CreateFileMappingFromApp /
         MapViewOfFileFromApp for the AppContainer. Without it dynarmic cannot mark JIT pages
         executable and common/host_memory.cpp cannot map the emulated DRAM. -->
    <Capability Name="codeGeneration" />
    <!-- core/network_interface + the NS services touch sockets on startup. -->
    <Capability Name="internetClient" />
    <!-- Local SMB/UNC shares also require private-network access. Folder/path resolution and
         Windows share authentication remain separate checks at runtime. -->
    <Capability Name="privateNetworkClientServer" />
    <!-- Lets the app enumerate/read supported file types from attached removable volumes. -->
    <uap:Capability Name="removableStorage" />
    <!-- PC Nintendo Pro USB transport; joystick usage is allowed by UWP HID. -->
    <DeviceCapability Name="humanInterfaceDevice" />
  </Capabilities>
</Package>
